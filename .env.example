# ==========================================
# MCOA Environment Variables Template
# ==========================================

# Production Database (Neon, Supabase, Vercel Postgres, or AWS RDS)
# Example: postgresql://username:password@ep-sample-1234.us-east-1.aws.neon.tech/mcoa_prod?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/mcoa_db"

# NextAuth Authentication
NEXTAUTH_SECRET="your-32-character-secret-generated-via-openssl"
NEXTAUTH_URL="https://medicalcodingofficersacademy.com"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Transactional Email (Resend / AWS SES / SMTP)
RESEND_API_KEY=""

# Academy Configuration
NEXT_PUBLIC_ACADEMY_PHONE="+91 8072020716"
NEXT_PUBLIC_ACADEMY_EMAIL="medicalcodingofficers@gmail.com"
NEXT_PUBLIC_ACADEMY_URL="https://medicalcodingofficersacademy.com"
