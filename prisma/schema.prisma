datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  address      String
  city         String
  state        String
  postalCode   String
  phone        String
  email        String
  isHeadOffice Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]
  users        User[]
}

model Course {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  shortCode          String
  category           String   // "Certification Prep" | "Medical Coding" | "Specialty" | "Billing"
  summary            String
  description        String
  duration           String
  feeInr             Int
  discountFeeInr     Int?
  certificationTrack String   // "AAPC CPC", "AHIMA CCS", "AAPC CRC", etc.
  trainingModes      String   // JSON string or comma-separated: "Online, Offline, Hybrid"
  eligibility        String   // JSON string of requirements
  syllabus           String   // JSON string of module list
  faqs               String   // JSON string of FAQ items
  isFeatured         Boolean  @default(false)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  leads              Lead[]
}

model Lead {
  id                  String     @id @default(cuid())
  fullName            String
  email               String
  phone               String
  educationBackground String     // "Medical", "Dental", "Nursing", "Pharmacy", "Biotech", "Life Sciences", "Other"
  mode                String     @default("Online") // "Online", "Offline", "Hybrid"
  preferredBatch      String     @default("Weekend") // "Weekday", "Weekend", "Evening"
  status              String     @default("New") // "New", "Contacted", "Qualified", "Counseling Scheduled", "Demo Scheduled", "Follow-up", "Interested", "Applied", "Enrolled", "Lost"
  source              String     @default("Website Inquiry")
  notes               String?
  utmSource           String?
  utmCampaign         String?
  
  courseId            String?
  course              Course?    @relation(fields: [courseId], references: [id])
  
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  
  assignedCounselorId String?
  assignedCounselor   User?      @relation(fields: [assignedCounselorId], references: [id])
  
  leadNotes           LeadNote[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model LeadNote {
  id        String   @id @default(cuid())
  content   String
  author    String   @default("System")
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("Admissions Counselor") // "Super Admin", "Branch Admin", "Admissions Counselor", "Academic Coordinator", "Trainer", "Student"
  phone        String?
  isActive     Boolean   @default(true)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  assignedLeads Lead[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "LEAD_CREATED", "LEAD_STATUS_CHANGED", "NOTE_ADDED", "USER_LOGIN"
  entityType  String   // "Lead", "Course", "User"
  entityId    String?
  performedBy String   @default("System")
  details     String?  // JSON string
  createdAt   DateTime @default(now())
}
