datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  address      String
  city         String
  state        String
  postalCode   String
  phone        String
  email        String
  isHeadOffice Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]
  users        User[]
  batches      Batch[]
}

model Course {
  id                 String       @id @default(cuid())
  slug               String       @unique
  title              String
  shortCode          String
  category           String       // "Certification Prep" | "Medical Coding" | "Specialty" | "Billing"
  summary            String
  description        String
  duration           String
  feeInr             Int
  discountFeeInr     Int?
  certificationTrack String       // "AAPC CPC", "AHIMA CCS", "AAPC CRC", etc.
  trainingModes      String       // JSON string: ["Classroom", "Online", "Hybrid"]
  eligibility        String       // JSON string of requirements
  syllabus           String       // JSON string of module list
  faqs               String       // JSON string of FAQ items
  isFeatured         Boolean      @default(false)
  isPublished        Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  leads              Lead[]
  batches            Batch[]
  enrollments        Enrollment[]
  modules            Module[]
  assignments        Assignment[]
  liveSessions       LiveSession[]
}

model Lead {
  id                  String     @id @default(cuid())
  fullName            String
  email               String
  phone               String
  educationBackground String     // "Medical", "Dental", "Nursing", "Pharmacy", "Biotech", "Life Sciences", "Other"
  mode                String     @default("Online") // "Online", "Offline", "Hybrid"
  preferredBatch      String     @default("Weekend") // "Weekday", "Weekend", "Evening"
  status              String     @default("New") // "New", "Contacted", "Qualified", "Counseling Scheduled", "Demo Scheduled", "Follow-up", "Interested", "Applied", "Enrolled", "Lost"
  source              String     @default("Website Inquiry")
  notes               String?
  utmSource           String?
  utmCampaign         String?
  
  courseId            String?
  course              Course?    @relation(fields: [courseId], references: [id])
  
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  
  assignedCounselorId String?
  assignedCounselor   User?      @relation(fields: [assignedCounselorId], references: [id])
  
  leadNotes           LeadNote[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model LeadNote {
  id        String   @id @default(cuid())
  content   String
  author    String   @default("System")
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  name              String
  passwordHash      String
  role              String                 @default("Admissions Counselor") // "Super Admin", "Branch Admin", "Admissions Counselor", "Academic Coordinator", "Trainer", "Student"
  phone             String?
  isActive          Boolean                @default(true)
  branchId          String?
  branch            Branch?                @relation(fields: [branchId], references: [id])
  assignedLeads     Lead[]
  trainedBatches    Batch[]                @relation("TrainerBatches")
  enrollments       Enrollment[]
  submissions       AssignmentSubmission[]
  attendanceRecords AttendanceRecord[]
  lessonProgress    LessonProgress[]
  studentNotes      StudentNote[]
  practiceAttempts  PracticeAttempt[]
  examAttempts      ExamAttempt[]
  paymentOrders     PaymentOrder[]
  jobApplications   JobApplication[]
  trainerLiveSessions LiveSession[]   @relation("TrainerLiveSessions")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Batch {
  id           String         @id @default(cuid())
  name         String
  code         String         @unique
  mode         String         @default("Classroom") // "Classroom", "Live Online", "Hybrid Flex"
  timing       String         @default("Weekend") // "Weekend", "Weekday", "Evening"
  startDate    DateTime
  endDate      DateTime?
  capacity     Int            @default(30)
  status       String         @default("Upcoming") // "Upcoming", "Active", "Completed"
  
  branchId     String?
  branch       Branch?        @relation(fields: [branchId], references: [id])
  
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id])
  
  trainerId    String?
  trainer      User?          @relation("TrainerBatches", fields: [trainerId], references: [id])
  
  enrollments  Enrollment[]
  sessions     BatchSession[]
  liveSessions LiveSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model BatchSession {
  id                String             @id @default(cuid())
  batchId           String
  batch             Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title             String
  sessionDate       DateTime
  startTime         String             // "10:00 AM"
  endTime           String             // "01:00 PM"
  meetUrl           String?
  recordingUrl      String?
  status            String             @default("Scheduled") // "Scheduled", "Completed", "Cancelled"
  attendanceRecords AttendanceRecord[]
  createdAt         DateTime           @default(now())
}

model Enrollment {
  id                String   @id @default(cuid())
  studentIdNumber   String   @unique // e.g. "MCOA-2026-CHN-001"
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  batchId           String?
  batch             Batch?   @relation(fields: [batchId], references: [id])
  status            String   @default("Active") // "Active", "Completed", "Paused"
  totalFee          Int
  paidFee           Int      @default(0)
  progressPercent   Int      @default(0)
  certificateIssued Boolean        @default(false)
  certificateId     String?
  paymentOrders     PaymentOrder[]
  enrollmentDate    DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(1)
  lessons   Lesson[]
  createdAt DateTime @default(now())
}

model Lesson {
  id            String           @id @default(cuid())
  moduleId      String
  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  order         Int              @default(1)
  duration      String           // "45 mins"
  videoUrl      String?          // URL to secure video or embed
  content       String?          // Lecture text/markdown summary
  pdfUrl        String?          // Study notes PDF reference
  isFreePreview Boolean          @default(false)
  progress      LessonProgress[]
  studentNotes  StudentNote[]
  createdAt     DateTime         @default(now())
}

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([lessonId, userId])
}

model Assignment {
  id          String                 @id @default(cuid())
  courseId    String
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  chartData   String?                // Clinical chart scenario for coding
  dueDate     DateTime
  maxScore    Int                    @default(100)
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now())
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String     // Student's coded solution, rationale, and codes
  score        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedBy     String?
  submittedAt  DateTime   @default(now())
}

model AttendanceRecord {
  id        String       @id @default(cuid())
  sessionId String
  session   BatchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String       @default("Present") // "Present", "Absent", "Late", "Excused"
  markedAt  DateTime     @default(now())

  @@unique([sessionId, userId])
}

model StudentNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

// ==========================================
// Phase 3: Coding Practice & Mock Exam Engine
// ==========================================

model PracticeCase {
  id               String            @id @default(cuid())
  slug             String            @unique
  title            String
  category         String            // "ICD-10-CM", "CPT Surgery", "E&M", "ICD-10-PCS", "MS-DRG", "HCC Risk Adjustment"
  difficulty       String            // "Beginner", "Intermediate", "Advanced"
  specialty        String            // "Cardiology", "Orthopedics", "General Surgery", "Gastroenterology", "Endocrinology", "Pulmonology"
  clinicalChart    String            // Authentic synthetic operative / encounter report
  recommendedCodes String            // JSON string: { primaryDiagnosis, secondaryDiagnoses, procedures, modifiers }
  rationale        String            // Step-by-step guideline explanation
  commonPitfalls   String?           // Frequent coding mistakes on this case
  guidelineRef     String?           // Official codebook guideline citation
  attempts         PracticeAttempt[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model PracticeAttempt {
  id          String       @id @default(cuid())
  caseId      String
  case        PracticeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userCodes   String       // JSON string of student submitted codes
  isCorrect   Boolean      @default(false)
  timeSpent   Int?         // in seconds
  createdAt   DateTime     @default(now())
}

model MockExam {
  id                  String         @id @default(cuid())
  slug                String         @unique
  title               String
  certificationTrack  String         // "AAPC CPC®", "AHIMA CCS®", "AAPC CRC®"
  description         String
  durationMinutes     Int            @default(120)
  totalQuestions      Int            @default(25)
  passingScorePercent Int            @default(70)
  questions           ExamQuestion[]
  attempts            ExamAttempt[]
  createdAt           DateTime       @default(now())
}

model ExamQuestion {
  id                 String   @id @default(cuid())
  examId             String
  exam               MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  domain             String   // "Surgery (10000-60000)", "Evaluation & Management", "Anesthesia & Radiology", "Pathology & Laboratory", "ICD-10-CM", "HCPCS & Compliance"
  questionText       String
  scenarioText       String?
  options            String   // JSON string: ["A) ...", "B) ...", "C) ...", "D) ..."]
  correctOptionIndex Int      // 0, 1, 2, or 3
  explanation        String   // Detailed rationale for the correct answer
  guidelineRef       String?  // Reference citation
  createdAt          DateTime @default(now())
}

model ExamAttempt {
  id               String   @id @default(cuid())
  examId           String
  exam             MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score            Int
  total            Int
  percentage       Int
  passed           Boolean
  domainScores     String   // JSON string: { "Surgery": { correct: 4, total: 5 }, "E&M": { correct: 3, total: 3 } }
  answers          String   // JSON string of user answers
  timeSpentSeconds Int
  completedAt      DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "LEAD_CREATED", "ENROLLMENT_APPROVED", "EXAM_COMPLETED", "PRACTICE_SUBMITTED"
  entityType  String   // "Lead", "Course", "User", "Enrollment", "Batch", "ExamAttempt"
  entityId    String?
  performedBy String   @default("System")
  details     String?  // JSON string
  createdAt   DateTime @default(now())
}

// ==========================================
// Phase 4: Payments, Live Sessions, Webinars, WhatsApp & Placements
// ==========================================

model PaymentOrder {
  id                String      @id @default(cuid())
  orderNumber       String      @unique // e.g. "ORD-2026-CHN-0082-1"
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId      String?
  enrollment        Enrollment? @relation(fields: [enrollmentId], references: [id])
  amount            Int         // in INR
  currency          String      @default("INR")
  status            String      @default("Created") // "Created", "Paid", "Failed", "Refunded"
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  installmentNumber Int         @default(1)
  dueDate           DateTime?
  paidAt            DateTime?
  invoiceNumber     String?     @unique
  paymentMethod     String?     // "UPI", "Netbanking", "Card", "Cash"
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model LiveSession {
  id                 String       @id @default(cuid())
  title              String
  batchId            String?
  batch              Batch?       @relation(fields: [batchId], references: [id])
  courseId           String?
  course             Course?      @relation(fields: [courseId], references: [id])
  trainerId          String?
  trainer            User?        @relation("TrainerLiveSessions", fields: [trainerId], references: [id])
  platform           String       @default("Zoom") // "Zoom", "Google Meet", "Classroom"
  meetingUrl         String
  meetingId          String?
  passcode           String?
  scheduledStartTime DateTime
  scheduledEndTime   DateTime
  status             String       @default("Scheduled") // "Scheduled", "Live", "Completed", "Cancelled"
  recordingUrl       String?
  agenda             String?
  attendanceCount    Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Webinar {
  id              String                @id @default(cuid())
  slug            String                @unique
  title           String
  speakerName     String
  speakerTitle    String
  description     String
  date            DateTime
  durationMinutes Int                   @default(90)
  isPaid          Boolean               @default(false)
  priceINR        Int                   @default(0)
  meetingPlatform String                @default("Zoom")
  meetingUrl      String
  maxAttendees    Int                   @default(500)
  status          String                @default("Upcoming") // "Upcoming", "Live", "Completed"
  registrations   WebinarRegistration[]
  createdAt       DateTime              @default(now())
}

model WebinarRegistration {
  id            String   @id @default(cuid())
  webinarId     String
  webinar       Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  name          String
  email         String
  phone         String
  education     String?
  city          String?
  paymentStatus String   @default("Free") // "Free", "Paid", "Pending"
  attended      Boolean  @default(false)
  registeredAt  DateTime @default(now())
}

model WhatsAppMessage {
  id                 String    @id @default(cuid())
  recipientPhone     String
  recipientName      String?
  templateName       String
  content            String
  status             String    @default("Sent") // "Queued", "Sent", "Delivered", "Read", "Failed"
  category           String    // "Admissions", "Academics", "Finance", "Placement"
  sentAt             DateTime  @default(now())
  deliveredAt        DateTime?
  readAt             DateTime?
  externalMessageId  String?
  errorDetails       String?
}

model JobOpening {
  id                     String           @id @default(cuid())
  title                  String
  companyName            String
  companyLogo            String?
  location               String
  employmentType         String           @default("Full-time")
  salaryRange            String
  vacancies              Int              @default(10)
  minExperience          String           @default("Fresher / Certified")
  requiredCertifications String
  jobDescription         String
  skillsRequired         String
  status                 String           @default("Active") // "Active", "Closed"
  applications           JobApplication[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model JobApplication {
  id             String     @id @default(cuid())
  jobId          String
  job            JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage          String     @default("Applied") // "Applied", "Screening", "Technical Interview", "Client Assessment", "Offered", "Placed", "Rejected"
  interviewDate  DateTime?
  interviewLink  String?
  offeredCtc     String?
  notes          String?
  appliedAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model AiConversation {
  id               String   @id @default(cuid())
  sessionId        String
  userId           String?
  role             String   // "user", "assistant", "system"
  content          String
  category         String   @default("counselor") // "counselor", "tutor", "exam_doubt", "general"
  citations        String?  // JSON string array of references/guidelines
  escalatedToHuman Boolean  @default(false)
  userEmail        String?
  userPhone        String?
  createdAt        DateTime @default(now())
}

model AiKnowledgeItem {
  id         String   @id @default(cuid())
  title      String
  category   String   // "courses", "guidelines", "fees_admissions", "exam_prep", "career_rcm"
  keywords   String   // comma separated terms for keyword matching & semantic retrieval
  content    String   // verified authoritative explanation
  source     String   // e.g. "MCOA Academic Handbook", "2026 ICD-10-CM Guideline Sec I.C.4"
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LandingPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  metaDescription String
  templateType    String   @default("cpc_bootcamp") // "cpc_bootcamp", "admissions_walkin", "corporate_placement", "masterclass_event"
  status          String   @default("Published")   // "Draft", "Published"
  heroBadge       String   @default("Official Admissions 2026")
  heroHeadline    String
  heroSubheadline String
  ctaText         String   @default("Claim Free Seat & Syllabus")
  sectionsJson    String   // JSON string containing structured blocks: benefits, highlights, curriculumPreview, stats, faq, testimonials
  viewsCount      Int      @default(0)
  leadsCount      Int      @default(0)
  targetBranch    String?  // "Chennai Head Office", "Perambalur", etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   // Markdown or rich HTML content
  authorName  String   @default("Dr. Jeevanantham Mariappan")
  authorRole  String   @default("Founder & CEO, MCOA")
  category    String   @default("Medical Coding") // "Medical Coding", "Exam Prep", "Career Pathways", "Coding Updates"
  readTime    String   @default("5 min read")
  tags        String   // comma separated tags
  isPublished Boolean  @default(true)
  coverImage  String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

